# Google Gemini API configuration
# Put your key ONLY in backend/.env — never in frontend JavaScript.
GEMINI_API_KEY=

# Primary + automatic fallback models. These are validated against the models
# available to your Gemini project; transient 429/5xx errors are retried.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_RETRIES=2
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TEMPERATURE=0.55
PORT=8787

# Use deterministic local responses when Gemini is missing or unavailable
DEMO_FALLBACK=true
